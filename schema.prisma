// ═══════════════════════════════════════════════════════════
// NOVA EPOKSI & ENDÜSTRİYEL ZEMİN — PRISMA SCHEMA DEFINITION
// High-Ticket B2B Lead Generation & Service Platform Mimarisi
// ═══════════════════════════════════════════════════════════

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// 1. ADMIN USER & AUTHENTICATION
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  passwordHash  String
  role          Role      @default(ADMIN)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
}

// 2. SERVICES & CATEGORY MANAGEMENT
model Service {
  id              String       @id @default(cuid())
  title           String       // Örn: "Multilayer Epoksi Zemin Kaplama"
  slug            String       @unique // Örn: "multilayer-epoksi-kaplama"
  summary         String       // Özet açıklama
  content         String       // Detaylı HTML / Markdown metin
  unitPriceTRY    Decimal      @db.Decimal(10, 2) // m² Birim Fiyat (TL)
  minAreaSquareM  Int          @default(50) // Minimum Keşif Alanı (m²)
  coverImage      String       // WebP kapak görseli URL
  seoTitle        String?
  seoDescription  String?
  ogImage         String?
  orderIndex      Int          @default(0)
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  leads           LeadForm[]
}

// 3. HIGH-CONVERSION B2B LEAD FORM
model LeadForm {
  id              String      @id @default(cuid())
  fullName        String
  phone           String
  companyName     String?
  city            String
  serviceId       String?
  service         Service?    @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  areaSquareMeters Int        // m² Ölçüsü
  calculatedBudget Decimal    @db.Decimal(12, 2) // Tahmini Bütçe (TL)
  userNote        String?
  status          LeadStatus  @default(NEW)
  ipAddress       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

enum LeadStatus {
  NEW           // Yeni Teklif Talebi
  CONTACTED     // İletişime Geçildi
  SITE_VISIT    // Ücretsiz Keşif Planlandı
  PROPOSAL_SENT // Teklif Sunuldu
  CLOSED_WON    // Müşteri Kapatıldı (Satış)
  CLOSED_LOST   // İptal Edildi
}

// 4. BLOG & SEO CONTENT CMS
model BlogPost {
  id             String       @id @default(cuid())
  title          String
  slug           String       @unique
  excerpt        String
  bodyContent    String
  coverImage     String
  category       String       @default("Rehber")
  seoTitle       String?
  seoDescription String?
  isPublished    Boolean      @default(true)
  publishedAt    DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

// 5. SYSTEM SETTINGS & PLATFORM CONFIG
model Setting {
  id             String    @id @default(cuid())
  key            String    @unique // Örn: "whatsapp_number", "google_analytics_id"
  value          String
  description    String?
  updatedAt      DateTime  @updatedAt
}
